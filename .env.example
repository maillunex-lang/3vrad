# Shared local development defaults (copy to .env — never commit real secrets)
APP_ENV=development
LOG_LEVEL=info

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=paradise
POSTGRES_PASSWORD=paradise_dev
POSTGRES_DB=paradise
DATABASE_URL=postgres://paradise:paradise_dev@localhost:5432/paradise?sslmode=disable

# API
SERVER_ADDR=:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Client (Vite)
VITE_API_BASE_URL=http://localhost:8080
