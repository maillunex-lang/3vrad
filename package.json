{
  "name": "paradise-island",
  "version": "0.1.0",
  "private": true,
  "description": "Райский остров — Match-3 PWA monorepo",
  "scripts": {
    "client:dev": "npm --prefix apps/client run dev",
    "client:build": "npm --prefix apps/client run build",
    "client:test": "npm --prefix apps/client run test",
    "admin:dev": "npm --prefix apps/admin run dev",
    "admin:build": "npm --prefix apps/admin run build",
    "server:test": "cd apps/server && go test ./...",
    "server:dev": "cd apps/server && go run ./cmd/server"
  },
  "engines": {
    "node": ">=22"
  }
}
